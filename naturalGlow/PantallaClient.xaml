<Window x:Class="naturalGlow.PantallaClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:naturalGlow"
        mc:Ignorable="d"
        Title="PantallaClient" Height="583" Width="1030"
        MinWidth="650" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1014" Height="551">
            <TabControl>

                <!-- PRODUCTES -->
                <TabItem Header="Productes">

                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="69*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0" Grid.ColumnSpan="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>


                            <TextBlock Text="Cerca producte:"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                            <TextBox x:Name="txtCerca"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="30"
                         TextChanged="TxtCerca_TextChanged"/>

                            <TextBlock Text="Categoria:"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                            <ComboBox x:Name="cmbCategoria"
                          Grid.Row="1"
                          Grid.Column="1"
                          Height="30"
                          SelectionChanged="CmbCategoria_SelectionChanged"/>

                            <TextBlock Text="Ordenar:"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                            <ComboBox x:Name="cmbOrdenar"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="30"
                          SelectionChanged="CmbOrdenar_SelectionChanged">

                                <ComboBoxItem Content="Preu: menor a major"/>
                                <ComboBoxItem Content="Preu: major a menor"/>
                                <ComboBoxItem Content="Novetats"/>

                            </ComboBox>

                        </Grid>

                        <DataGrid x:Name="dgProductes"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column" Grid.ColumnSpan="2">

                            <DataGrid.Columns>


                                <DataGridTemplateColumn Header="Imatge"
                                        Width="110">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Width="70"
                                    Height="140"
                                    Background="LightGray">

                                                <Image Source="{Binding ImatgeURL}"
                                       Stretch="Uniform"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <DataGridTextColumn Header="Nom"
                                    Width="300"
                                    Binding="{Binding Nom}"/>


                                <DataGridTextColumn Header="Categoria"
                                    Width="300"
                                    Binding="{Binding Categoria}"/>

                                <DataGridTextColumn Header="Preu"
                                    Width="135"
                                    Binding="{Binding PreuVenda}"/>

                                <DataGridTemplateColumn Header="Comprar"
                                        Width="140">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="Comprar"
                                    Width="108"
                                    Height="68"
                                    FontSize="16"
                                    Click="BtnComprar_Click"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- CARRETO -->
                <TabItem Header="Carreto">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="dgCarreto"
                  Grid.Row="0"
                  Height="120"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="4">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Nom"
                                    Width="*"
                                    Binding="{Binding NomProducte}"/>

                                <DataGridTextColumn Header="Quantitat"
                                    Width="110"
                                    Binding="{Binding Quantitat}"/>

                                <DataGridTextColumn Header="Preu"
                                    Width="100"
                                    Binding="{Binding PreuUnitari, StringFormat={}{0:F2} €}"/>

                                <DataGridTextColumn Header="Subtotal"
                                    Width="110"
                                    Binding="{Binding Subtotal, StringFormat={}{0:F2} €}"/>

                                <DataGridTemplateColumn Header="Eliminar"
                                        Width="110">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button Content="Eliminar"
                                    Width="85"
                                    Height="25"
                                    Click="BtnEliminarCarreto_Click"/>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>


                        <Grid Grid.Row="2"
                        Margin="4,15,4,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Total:"
                       Grid.Column="0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,8,0"/>

                            <TextBox x:Name="txtTotal"
                     Grid.Column="1"
                     Height="30"
                     FontSize="16"
                     IsReadOnly="True"/>

                        </Grid>


                        <TextBlock Text="Pagament"
                   Grid.Row="3"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="4,0,0,15"/>


                        <Grid Grid.Row="4" 
                     Margin="4,0,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Nom Titular:"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtNomTitular"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="25"/>

                            <TextBlock Text="Número Targeta:"
                       Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtNumeroTargeta"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="25"/>


                            <TextBlock Text="Data Caducitat:"
                       Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtDataCaducitat"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="25"/>


                            <TextBlock Text="CVV:"
                       Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtCVV"
                     Grid.Row="3"
                     Grid.Column="1"
                     Width="95"
                     Height="25"
                     HorizontalAlignment="Left"/>

                            <Button x:Name="btnPagar"
                    Content="PAGAR"
                    Grid.Row="3"
                    Grid.Column="2"
                    Width="150"
                    Height="35"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,0"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="BtnPagar_Click"/>

                        </Grid>

                    </Grid>

                </TabItem>

                <!-- COMANDES -->
                <TabItem Header="Comandes">

                    <Grid Margin="10">

                        <DataGrid x:Name="dgComandes"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Id"
                                    Width="220"
                                    Binding="{Binding Id}"/>


                                <DataGridTextColumn Header="Preu total"
                                    Width="130"
                                    Binding="{Binding Total, StringFormat={}{0:F2} €}"/>


                                <DataGridTextColumn Header="Estat"
                                    Width="150"
                                    Binding="{Binding Estat}"/>


                                <DataGridTextColumn Header="Data"
                                    Width="180"
                                    Binding="{Binding Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>


                                <DataGridTemplateColumn Header="Factura"
                                        Width="120">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="PDF"
                                    Width="80"
                                    Height="30"
                                    FontWeight="Bold"
                                    Click="BtnFactura_Click"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- MISSATGES -->
                <TabItem Header="Missatges">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                Background="#2F8BEA"
                CornerRadius="8"
                Margin="0,0,0,10">

                            <TextBlock Text="Venedor"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>

                        </Border>

                        <ScrollViewer Grid.Row="1"
                      x:Name="scrollMissatges"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                            <StackPanel x:Name="panelMissatges"
                        Margin="0,5,0,5"/>

                        </ScrollViewer>

                        <Grid Grid.Row="2"
                     Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>


                            <TextBox x:Name="txtMissatgeVenedor"
                     Grid.Column="0"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>


                            <Button x:Name="btnEnviarMissatgeVenedor"
                    Grid.Column="1"
                    Content="Enviar"
                    Height="32"
                    Click="BtnEnviarMissatgeVenedor_Click"/>

                        </Grid>

                    </Grid>

                </TabItem>


                <!-- PERFIL -->
                <TabItem Header="Perfil">
                    <Grid Margin="14,8,14,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="El meu perfil"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

                            <Button x:Name="btnTancarSessio"
                    Content="Tancar sessió"
                    Width="110"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="BtnTancarSessio_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Nom"
                       FontSize="11"
                       Margin="0,0,0,3"/>

                            <TextBox x:Name="txtNom"
                     Height="25"
                     HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Email"
                       FontSize="11"
                       Margin="0,0,0,3"/>

                            <TextBox x:Name="txtEmail"
                     Height="25"
                     HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Telefon"
                       FontSize="11"
                       Margin="0,0,0,3"/>

                            <TextBox x:Name="txtTelefon"
                     Height="25"
                     HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5">
                            <TextBlock Text="Adreça"
                       FontSize="11"
                       Margin="0,0,0,3"/>

                            <TextBox x:Name="txtAdreca"
                     Height="25"
                     HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Button x:Name="btnGuardarPerfil"
                        Grid.Row="6"
                        Content="Guardar"
                        Width="75"
                        Height="27"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="BtnGuardarPerfil_Click"/>

                        <StackPanel Grid.Row="7">
                            <TextBlock Text="Contrasenya"
                       FontSize="11"
                       Margin="0,0,0,3"/>

                            <PasswordBox x:Name="txtContrasenya"
                         Height="25"
                         HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Button x:Name="btnCanviarContrasenya"
                        Grid.Row="8"
                        Content="Canviar"
                        Width="75"
                        Height="27"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="BtnCanviarContrasenya_Click"/>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Viewbox>
</Window>
